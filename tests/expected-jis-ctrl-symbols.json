{
  "basis": "Independent physical JIS scan-code expectations. Ctrl is held in every case. Chinese punctuation retains Microsoft Bopomofo's lenticular brackets and ideographic full stop. The JIS yen/ro keys retain Windows backslash semantics.",
  "symbols": [
    {"scan":"0x02","shift":true,"keycap":"1 !","expected":"！"},
    {"scan":"0x03","shift":true,"keycap":"2 quote","expected":"＂"},
    {"scan":"0x04","shift":true,"keycap":"3 #","expected":"＃"},
    {"scan":"0x05","shift":true,"keycap":"4 $","expected":"＄"},
    {"scan":"0x06","shift":true,"keycap":"5 %","expected":"％"},
    {"scan":"0x07","shift":true,"keycap":"6 &","expected":"＆"},
    {"scan":"0x08","shift":true,"keycap":"7 apostrophe","expected":"＇"},
    {"scan":"0x09","shift":true,"keycap":"8 (","expected":"（"},
    {"scan":"0x0a","shift":true,"keycap":"9 )","expected":"）"},
    {"scan":"0x0c","shift":false,"keycap":"- =","expected":"－"},
    {"scan":"0x0c","shift":true,"keycap":"- =","expected":"＝"},
    {"scan":"0x0d","shift":false,"keycap":"^ ~","expected":"＾"},
    {"scan":"0x0d","shift":true,"keycap":"^ ~","expected":"～"},
    {"scan":"0x1a","shift":false,"keycap":"@ grave","expected":"＠"},
    {"scan":"0x1a","shift":true,"keycap":"@ grave","expected":"｀"},
    {"scan":"0x1b","shift":false,"keycap":"[ {","expected":"【"},
    {"scan":"0x1b","shift":true,"keycap":"[ {","expected":"｛"},
    {"scan":"0x27","shift":false,"keycap":"; +","expected":"；"},
    {"scan":"0x27","shift":true,"keycap":"; +","expected":"＋"},
    {"scan":"0x28","shift":false,"keycap":": *","expected":"："},
    {"scan":"0x28","shift":true,"keycap":": *","expected":"＊"},
    {"scan":"0x2b","shift":false,"keycap":"] }","expected":"】"},
    {"scan":"0x2b","shift":true,"keycap":"] }","expected":"｝"},
    {"scan":"0x7d","shift":false,"keycap":"yen |","expected":"＼"},
    {"scan":"0x7d","shift":true,"keycap":"yen |","expected":"｜"},
    {"scan":"0x73","shift":false,"keycap":"backslash _ ro","expected":"＼"},
    {"scan":"0x73","shift":true,"keycap":"backslash _ ro","expected":"＿"},
    {"scan":"0x33","shift":false,"keycap":", <","expected":"，"},
    {"scan":"0x33","shift":true,"keycap":", <","expected":"＜"},
    {"scan":"0x34","shift":false,"keycap":". >","expected":"。"},
    {"scan":"0x34","shift":true,"keycap":". >","expected":"＞"},
    {"scan":"0x35","shift":false,"keycap":"/ ?","expected":"／"},
    {"scan":"0x35","shift":true,"keycap":"/ ?","expected":"？"}
  ]
}
